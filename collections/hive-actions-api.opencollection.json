          "info": {
            "name": "Create an action (task)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hive.com/api/v1/actions"
          },
          "docs": "Create an action (task)"
        },
        {
          "info": {
            "name": "Get an action",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hive.com/api/v1/actions/:actionId",
            "params": [
              {
                "name": "actionId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an action"
        },
        {
          "info": {
            "name": "Update an action",
            "type": "http"
          },
