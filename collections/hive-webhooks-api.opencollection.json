{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hive Public Actions Webhooks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hive.com/api/v1/webhooks"
          },
          "docs": "Create a webhook"
        },
        {
          "info": {
            "name": "Delete a webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.hive.com/api/v1/webhooks/:webhookId",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a webhook"
        }
      ]
    }
  ],
  "bundled": true
}