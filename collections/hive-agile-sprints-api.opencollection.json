            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hive.com/api/v1/agile_sprints/:sprintId",
            "params": [
              {
                "name": "sprintId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a sprint"
        }
      ]
    }
  ],
  "bundled": true
}