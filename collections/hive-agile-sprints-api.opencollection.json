{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hive Public Actions Agile Sprints API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Agile Sprints",
        "type": "folder"
      },
      "items": [
        {
          "info": {
