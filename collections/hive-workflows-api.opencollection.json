{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hive Public Actions Workflows API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workflows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Trigger a workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hive.com/api/v1/workflows/trigger"
          },
          "docs": "Trigger a workflow"
        }
      ]
    }
  ],
  "bundled": true
}