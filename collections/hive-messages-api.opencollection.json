{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hive Public Actions Messages API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Messages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send a chat message",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hive.com/api/v1/messages"
          },
          "docs": "Send a chat message"
        }
      ]
    }
  ],
  "bundled": true
}