{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hive Public Actions Teams API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a team",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hive.com/api/v1/teams"
          },
          "docs": "Create a team"
        },
        {
          "info": {
            "name": "Update a team",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.hive.com/api/v1/teams/:teamId",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update a team"
        },
        {
          "info": {
            "name": "Delete a team",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.hive.com/api/v1/teams/:teamId",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a team"
        },
        {
          "info": {
            "name": "Add a team member",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hive.com/api/v1/teams/:teamId/members",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Add a team member"
        },
        {
          "info": {
            "name": "Remove a team member",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.hive.com/api/v1/teams/:teamId/members",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove a team member"
        }
      ]
    }
  ],
  "bundled": true
}